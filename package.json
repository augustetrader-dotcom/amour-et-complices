{
  "name": "couple-app-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "seed": "node scripts/seed_content.js",
    "migrate:profiles": "node scripts/migrate_profiles.js",
    "clean-metadata": "node scripts/clean_metadata.js",
    "generate-icons": "node scripts/generate-icons.js",
    "test": "jest --testPathIgnorePatterns=tests/e2e",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:e2e": "jest --testPathPattern=tests/e2e",
    "test:security": "npm audit && npm run test:owasp",
    "test:owasp": "jest --testPathPattern=tests/security",
    "test:production": "jest --testPathPattern=tests/production",
    "test:all": "jest --testPathIgnorePatterns=tests/e2e --coverage",
    "test:watch": "jest --testPathIgnorePatterns=tests/e2e --watch",
    "test:e2e:with-server": "start-server-and-test start http://localhost:3000 test:e2e"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "jest-puppeteer": "^6.1.0",
    "puppeteer": "^21.5.0",
    "sharp": "^0.35.4",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "routes/**/*.js",
      "services/**/*.js",
      "!**/node_modules/**"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ]
  }
}
