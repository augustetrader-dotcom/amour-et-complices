# Copie ce fichier en ".env" et remplis avec les valeurs de ton projet Supabase
# (Dashboard Supabase > Project Settings > API)

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clé service_role — jamais exposée au frontend, uniquement utilisée ici côté serveur
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

PORT=3000
